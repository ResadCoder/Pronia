@model  Pronia.Areas.Manage.ViewModels.Coupon.CouponCreateVM
<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Products</h4>
            <form class="forms-sample" method="post" enctype="multipart/form-data">
                <div class="form-group">
                    <label asp-for="Code"></label>
                    <input asp-for="Code" class="form-control" placeholder="Code" a>
                    <span class="text-danger pt-2  fs-6 small  fw-light" asp-validation-for="Code"></span>
                </div>
                <div class="form-group">
                    <label asp-for="DiscountAmount"></label>
                    <input asp-for="DiscountAmount" class="form-control" placeholder="DiscountAmount" >
                    <span class="text-danger pt-2  fs-6 small  fw-light" asp-validation-for="DiscountAmount"></span>
                </div>
                <div class="form-group">
                    <label asp-for="IsActive"></label>
                    <select asp-for="IsActive" class="form-control">
                        <option value="true">True</option>
                        <option value="false">False</option>
                    </select>
                    <span class="text-danger pt-2 fs-6 small fw-light" asp-validation-for="IsActive"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ExpirationDate"></label>
                    <input asp-for="ExpirationDate" class="form-control" placeholder="ExpirationDate" >
                    <span class="text-danger pt-2  fs-6 small  fw-light" asp-validation-for="ExpirationDate"></span>
                </div>
                <button type="submit" class="btn btn-primary me-2">Submit</button>
                <a asp-controller="Cupon" asp-action="Index" class="btn btn-light">Cancel</a>
            </form>
        </div>
    </div>
</div>

