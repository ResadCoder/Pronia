@using Pronia.Extensions
@model HeaderVM

<header class="main-header-area">
    <div class="header-top bg-pronia-primary d-none d-lg-block">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-6">
                    <div class="header-top-left">
                        <span class="pronia-offer">HELLO EVERYONE! 25% Off All Products</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="header-top-right">
                        <ul class="dropdown-wrap">
                            <li class="dropdown">
                                <button class="btn btn-link dropdown-toggle ht-btn" type="button" id="currencyButton"
                                        data-bs-toggle="dropdown" aria-label="currency" aria-expanded="false">USD
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="currencyButton">
                                    <li><a class="dropdown-item" href="#">GBP</a></li>
                                    <li><a class="dropdown-item" href="#">ISO</a></li>
                                </ul>
                            </li>
                            <li class="dropdown">
                                <button class="btn btn-link dropdown-toggle ht-btn" type="button" id="languageButton"
                                        data-bs-toggle="dropdown" aria-label="language" aria-expanded="false">English
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="languageButton">
                                    <li><a class="dropdown-item" href="#">French</a></li>
                                    <li><a class="dropdown-item" href="#">Italian</a></li>
                                    <li><a class="dropdown-item" href="#">Spanish</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="header-middle py-30">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-12">
                    <div class="header-middle-wrap position-relative">
                        <div class="header-contact d-none d-lg-flex">
                            <i class="pe-7s-call"></i>
                            <a href="tel://@Model.Settings["Phone"]">@Model.Settings["Phone"]</a>
                        </div>
                        <a href="/" class="header-logo">
                            <img src="~/assets/images/logo/dark.png" alt="Header Logo"/>
                        </a>
                        <div class="header-right">
                            <ul>
                                <li><a href="#exampleModal" class="search-btn bt" data-bs-toggle="modal" data-bs-target="#exampleModal"><i class="pe-7s-search"></i></a></li>
                                <li class="dropdown d-none d-lg-block">
                                    <button class="btn btn-link dropdown-toggle ht-btn p-0" type="button" id="settingButton"
                                            data-bs-toggle="dropdown" aria-label="setting" aria-expanded="false">
                                        <i class="pe-7s-users"></i>
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="settingButton">
                                        @if (User.Identity is { IsAuthenticated: true })
                                        {
                                            <li><a class="dropdown-item" asp-controller="Account" asp-action="MyAccount">My account</a></li>
                                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout">Logout</a></li>
                                        }
                                        else
                                        {
                                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Login">Login</a></li>
                                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Register">Register</a></li>
                                        }
                                    </ul>
                                </li>
                                <li class="d-none d-lg-block"><a href="wishlist.html"><i class="pe-7s-like"></i></a></li>
                                <li class="minicart-wrap me-3 me-lg-0"><a href="#miniCart" class="minicart-btn toolbar-btn"><i class="pe-7s-shopbag"></i><span class="quantity">@Model.BasketItems.Count</span></a></li>
                                <li class="mobile-menu_wrap d-block d-lg-none"><a href="#mobileMenu" class="mobile-menu_btn toolbar-btn pl-0"><i class="pe-7s-menu"></i></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="header-bottom d-none d-lg-block">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="main-menu position-relative">
                        <nav class="main-nav">
                            <ul class="main-menu">
                                <li class="drop-holder">
                                    <a asp-controller="Home" asp-action="Index">Home</a>
                                    <ul class="drop-menu">
                                        <li><a asp-controller="Home" asp-action="Index">Home One</a></li>
                                        <li><a href="index-2.html">Home Two</a></li>
                                    </ul>
                                </li>
                                <li class="megamenu-holder">
                                    <a href="/shop">Shop</a>
                                    <ul class="drop-menu megamenu">
                                        <li>
                                            <span class="title">Shop Layout</span>
                                            <ul>
                                                <li><a href="/shop">Shop Default</a></li>
                                                <li><a href="shop-grid-fullwidth.html">Shop Grid Fullwidth</a></li>
                                                <li><a href="shop-right-sidebar.html">Shop Right Sidebar</a></li>
                                                <li><a href="shop-list-fullwidth.html">Shop List Fullwidth</a></li>
                                                <li><a href="shop-list-left-sidebar.html">Shop List Left Sidebar</a></li>
                                                <li><a href="shop-list-right-sidebar.html">Shop List Right Sidebar</a></li>
                                            </ul>
                                        </li>
                                        <li>
                                            <span class="title">Product Related</span>
                                            <ul>
                                                @if (User.Identity is { IsAuthenticated: true })
                                                {
                                                    <li><a asp-controller="Account" asp-action="MyAccount">My Account</a></li>
                                                    <li><a asp-controller="Account" asp-action="Logout">Logout</a></li>
                                                }
                                                else
                                                {
                                                    <li><a asp-controller="Account" asp-action="Login">Login</a></li>
                                                    <li><a asp-controller="Account" asp-action="Register">Register</a></li>
                                                }
                                                <li><a href="cart.html">Shopping Cart</a></li>
                                                <li><a href="wishlist.html">Wishlist</a></li>
                                                <li><a href="compare.html">Compare</a></li>
                                                <li><a href="checkout.html">Checkout</a></li>
                                            </ul>
                                        </li>
                                    </ul>
                                </li>
                                <li class="drop-holder">
                                    <a href="blog.html">Blog</a>
                                    <ul class="drop-menu">
                                        <li><a href="blog-listview.html">Blog List View</a></li>
                                        <li><a href="blog-detail.html">Blog Detail</a></li>
                                    </ul>
                                </li>
                                <li><a href="about.html">About Us</a></li>
                                <li class="drop-holder">
                                    <a href="#">Pages</a>
                                    <ul class="drop-menu">
                                        <li><a href="faq.html">FAQ</a></li>
                                        <li><a href="404.html">Error 404</a></li>
                                    </ul>
                                </li>
                                <li><a href="contact.html">Contact Us</a></li>
                                @if (User.Identity is { IsAuthenticated: true } && User.IsInRole(nameof(UserRoleEnum.Admin)))
                                {
                                    <li class="drop-holder">
                                        <a asp-area="Manage" asp-controller="Dashboard" asp-action="Index">Manage</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="header-sticky py-4 py-lg-0">
        <div class="container">
            <div class="header-nav position-relative">
                <div class="row align-items-center">
                    <div class="col-lg-3 col-6">
                        <a href="/" class="header-logo">
                            <img src="~/assets/images/logo/dark.png" alt="Header Logo"/>
                        </a>
                    </div>
                    <div class="col-lg-6 d-none d-lg-block">
                    </div>
                    <div class="col-lg-3 col-6">
                        <div class="header-right">
                            <ul>
                                <li><a href="#exampleModal" class="search-btn bt" data-bs-toggle="modal" data-bs-target="#exampleModal"><i class="pe-7s-search"></i></a></li>
                                <li class="dropdown d-none d-lg-block">
                                    <button class="btn btn-link dropdown-toggle ht-btn p-0" type="button" id="stickysettingButton"
                                            data-bs-toggle="dropdown" aria-label="setting" aria-expanded="false">
                                        <i class="pe-7s-users"></i>
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="stickysettingButton">
                                        @if (User.Identity is { IsAuthenticated: true })
                                        {
                                            <li><a class="dropdown-item" asp-controller="Account" asp-action="MyAccount">My account</a></li>
                                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout">Logout</a></li>
                                        }
                                        else
                                        {
                                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Login">Login</a></li>
                                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Register">Register</a></li>
                                        }
                                    </ul>
                                </li>
                                <li class="d-none d-lg-block"><a href="wishlist.html"><i class="pe-7s-like"></i></a></li>
                                <li class="minicart-wrap me-3 me-lg-0"><a href="#miniCart" class="minicart-btn toolbar-btn"><i class="pe-7s-shopbag"></i><span class="quantity">3</span></a></li>
                                <li class="mobile-menu_wrap d-block d-lg-none"><a href="#mobileMenu" class="mobile-menu_btn toolbar-btn pl-0"><i class="pe-7s-menu"></i></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="mobile-menu_wrapper" id="mobileMenu">
        <div class="offcanvas-body">
            <div class="offcanvas-user-info">
                <ul class="dropdown-wrap">
                    <li class="dropdown">
                        <button class="btn btn-link dropdown-toggle ht-btn p-0" type="button" id="settingButtonTwo" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="pe-7s-users"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="settingButtonTwo">
                            @if (User.Identity is { IsAuthenticated: true })
                            {
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="MyAccount">My account</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout">Logout</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Login">Login</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Register">Register</a></li>
                            }
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </div>
   @await Html.PartialAsync("_BasketPartialView",Model.BasketItems)
    
</header>