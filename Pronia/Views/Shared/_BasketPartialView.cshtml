@model List<BasketItemVM> 
<div class="offcanvas-minicart_wrapper" id="miniCart">
  <div class="offcanvas-body">
    <div class="minicart-content">
      <div class="minicart-heading">
        <h4 class="mb-0">Shopping Cart</h4>
        <a href="#" class="button-close"
        ><i
           class="pe-7s-close"
           data-tippy="Close"
           data-tippy-inertia="true"
           data-tippy-animation="shift-away"
           data-tippy-delay="50"
           data-tippy-arrow="true"
           data-tippy-theme="sharpborder"
         ></i
        ></a>
      </div>
      <ul class="minicart-list">
        @foreach (BasketItemVM vm in Model)
        {

          <li class="minicart-product">
            <a class="product-item_remove" asp-controller="Basket" asp-action="Remove" asp-route-productId="@vm.ProductId">
              <i
                class="pe-7s-close"
                data-tippy="Remove"
                data-tippy-inertia="true"
                data-tippy-animation="shift-away"
                data-tippy-delay="50"
                data-tippy-arrow="true"
                data-tippy-theme="sharpborder"></i
              ></a>
            <a
              asp-controller="Product" asp-action="Index"
              class="product-item_img">
              <img
                class="img-full"
                src="~/admin/media/products/@vm.MainImage"
                alt="Product Image"/>
            </a>
            <div class="product-item_content">
              <a
                class="product-item_title"
                asp-controller="Product" asp-action="Index">@vm.ProductName</a
              >
              <span class="product-item_quantity">@vm.Count x @vm.Price</span>
            </div>
          </li>
        }
      </ul>
    </div>
    <div class="minicart-item_total">
      <span>Subtotal</span>
      <span class="ammount">@Model.Sum(x => x.Subtotal)</span>
    </div>
    <div class="group-btn_wrap d-grid gap-2">
      <a asp-controller="Basket" asp-action="Index" class="btn btn-dark">View Cart</a>
      <a href="checkout.html" class="btn btn-dark">Checkout</a>
    </div>
  </div>
  </div>